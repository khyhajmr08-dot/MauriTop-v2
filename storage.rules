rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        request.auth.uid == 'PqXqqCgdC1eYPz4HKHHLtDRejPD3' ||
        (
          request.auth.token.email != null &&
          request.auth.token.email.lower() == 'khyhajmr08@gmail.com' &&
          request.auth.token.email_verified == true
        )
      );
    }

    function validPublicImageUpload(maxBytes) {
      return request.resource != null &&
        request.resource.size > 0 && request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    // Publicly displayed service imagery: only the trusted owner can modify it.
    match /services/{fileName} {
      allow read: if true;
      allow create, update: if isOwner() && validPublicImageUpload(8 * 1024 * 1024);
      allow delete: if isOwner();
    }

    // Payment method logos: managed by trusted owner
    match /payment-methods/{fileName} {
      allow read: if true;
      allow create, update: if isOwner() && validPublicImageUpload(5 * 1024 * 1024);
      allow delete: if isOwner();
    }

    // Publicly displayed promotional imagery: only the trusted owner can modify it.
    match /posts/{fileName} {
      allow read: if true;
      allow create, update: if isOwner() && validPublicImageUpload(8 * 1024 * 1024);
      allow delete: if isOwner();
    }

    // Payment proofs: Authenticated customers upload to /order-receipts/{userId}/
    // Guests upload to /order-receipts/guest/ with non-enumerable files.
    // Read access is STRICTLY restricted: Owner or authenticated owner of userId.
    // Guests NEVER have SDK read access to receipts or receipt directories.
    // Backend server verifies and generates temporary signed URLs when required.
    match /order-receipts/{userId}/{fileName} {
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == userId);
      allow create, update: if (
        (isSignedIn() && request.auth.uid == userId) ||
        (userId == 'guest' && fileName.size() >= 16)
      ) && validPublicImageUpload(8 * 1024 * 1024);
      allow delete: if isOwner();
    }

    // No broad catch-all write/read grants. Add future paths only with explicit
    // ownership, size, and content-type rules after inspecting their code usage.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
